# Model Provider: "anthropic" (Claude), "google" (Gemini), or "azure_openai" (Azure OpenAI)
MODEL_PROVIDER=anthropic

# Anthropic API Key (required for Claude models)
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google API Key (required for Gemini models)
# Get at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# Azure OpenAI (required for Azure OpenAI models)
# Get at: https://portal.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Tavily API Key (required for web search)
# Get free key (1000/month) at: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key
